# Copy to .env.local for development. Every variable is optional locally:
# without Supabase the site serves the placeholder "preview" catalog, and the
# quote/service forms explain that online requests aren't available yet.

# Public site URL (canonical links, sitemap, Turnstile hostname check)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used to store quote/service requests and by `npm run seed:catalog`.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile spam check on the request forms. Required in production:
# without TURNSTILE_SECRET_KEY the forms refuse submissions outside development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Extra hostnames allowed in Turnstile responses (comma-separated), e.g. preview domains.
TURNSTILE_ALLOWED_HOSTNAMES=

# Resend: staff notification + customer confirmation for each request.
RESEND_API_KEY=
MORSE_EMAIL_FROM="Morse Electric Motor Co. <service@example.com>"
# Comma-separated staff inboxes for new requests.
MORSE_STAFF_EMAIL=

# Business details shown on the site (placeholders render until these are set).
NEXT_PUBLIC_MORSE_PHONE=
NEXT_PUBLIC_MORSE_EMAIL=
NEXT_PUBLIC_MORSE_STREET=
NEXT_PUBLIC_MORSE_CITY=
NEXT_PUBLIC_MORSE_HOURS=
NEXT_PUBLIC_MORSE_SERVICE_AREA=
