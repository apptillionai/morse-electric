# Copy to .env.local for development. Every variable is optional locally:
# without Supabase the site serves the placeholder "preview" catalog, and the
# quote/service forms explain that online requests aren't available yet.

# Public site URL (canonical links, sitemap, Turnstile hostname check)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used to store quote/service requests and by `npm run seed:catalog`.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile spam check on the request forms. Required in production:
# without TURNSTILE_SECRET_KEY the forms refuse submissions outside development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Extra hostnames allowed in Turnstile responses (comma-separated), e.g. preview domains.
TURNSTILE_ALLOWED_HOSTNAMES=

# Resend: staff notification + customer confirmation for each request.
RESEND_API_KEY=
MORSE_EMAIL_FROM="Morse Electric Motor Co. <service@example.com>"
# Comma-separated staff inboxes for new requests.
MORSE_STAFF_EMAIL=

# Stripe (online store). Use test keys everywhere except production. The
# webhook secret comes from the endpoint you add for /api/stripe/webhook.
# Checkout stays closed until both are set AND the store is switched on at
# /admin/settings.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel Cron sends this as a bearer token to /api/cron/core-reminders (daily
# core-return reminder emails). Any long random string.
CRON_SECRET=

# Shippo (live UPS/FedEx/USPS rates in the cart). Test token (shippo_test_…)
# for previews, live token for production. Rates stay on the weight bands
# until this is set AND "Use live carrier rates" is ticked at /admin/settings.
SHIPPO_API_KEY=

# Phone, email, address, hours and service area are edited by staff at
# /admin/settings (stored in public.site_settings), not here.
